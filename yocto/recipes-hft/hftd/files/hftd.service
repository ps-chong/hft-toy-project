[Unit]
Description=MYD-CZU5EV-V2 HFT control and OUCH gateway
After=network-online.target postgresql.service hft-remoteproc.service
Wants=network-online.target postgresql.service
Requires=hft-remoteproc.service
ConditionPathExists=/dev/rpmsg0

[Service]
Type=simple
User=hft
Group=hft
EnvironmentFile=-/data/hft/hftd.env
ExecStart=/usr/bin/hftd
Restart=on-failure
RestartSec=1
RuntimeDirectory=hftd
StateDirectory=hft
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/hftd /data/hft
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
