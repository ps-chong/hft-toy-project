[Unit]
Description=MYD-CZU5EV-V2 HFT control and OUCH gateway
After=network-online.target postgresql.service hft-remoteproc.service hft-data-prepare.service
Wants=network-online.target postgresql.service
Requires=hft-remoteproc.service hft-data-prepare.service
RequiresMountsFor=/data
ConditionPathExists=/dev/rpmsg0

[Service]
# hftd sends READY=1 once the R5, the exchange and the journal are connected
# and its tasks run, so units ordered after it (hft-update-health) wait for a
# working daemon. start-up retries each connection for HFT_CONNECT_ATTEMPTS
# seconds (30 by default), hence the generous start timeout.
Type=notify
NotifyAccess=main
TimeoutStartSec=180
# A runtime that stops scheduling stops the pings; systemd then aborts the
# process and Restart= brings it back. One stuck task is not detected here.
WatchdogSec=10
User=hft
Group=hft
EnvironmentFile=-/data/hft/hftd.env
ExecStart=/usr/bin/hftd
Restart=on-failure
RestartSec=1
RuntimeDirectory=hftd
StateDirectory=hft
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/hftd /data/hft
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
